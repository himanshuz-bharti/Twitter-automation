# Local/open model drafting. Ollama is the default free local provider.
# Install Ollama, then run: ollama pull llama3.2:3b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Hugging Face Inference API provider. Some hosted models/usage may require a token.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Telegram delivery for manual X posting.
# Create a bot with @BotFather, then send the bot one message before running telegram-check.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X/Twitter posting credentials. X may require paid API credits for /2/tweets.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional image search fallback. Without this, the agent uses article/page images and DuckDuckGo scraping.
# SerpAPI docs: https://serpapi.com/images-results
SERPAPI_API_KEY=

# Pipeline defaults
NEWS_LOOKBACK_HOURS=24
MAX_ARTICLES=80
DEFAULT_STYLE=ragebait