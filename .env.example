# Local/open model drafting. Ollama is the default free local provider.
# Install Ollama, then run: ollama pull llama3.2:3b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Hugging Face Inference API provider. Some hosted models/usage may require a token.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# X/Twitter posting credentials. Use dry-run for review, then --post for publishing.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional image search fallback. Without this, the agent uses article metadata images only.
# SerpAPI docs: https://serpapi.com/images-results
SERPAPI_API_KEY=

# Telegram Bot Token Key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_HANDLE=

# Pipeline defaults
NEWS_LOOKBACK_HOURS=24
MAX_ARTICLES=80
DEFAULT_STYLE=ragebait

# If DuckDuckGo and RSS fail, these APIs are used as a final fallback layer.
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=
MEDIASTACK_API_KEY=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
